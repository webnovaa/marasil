APP_NAME=Marasil
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=whatsapp_saas
DB_USERNAME=whatsapp
DB_PASSWORD=change_me_db_password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=local
MEDIA_MAX_UPLOAD_MB=16
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=change_me_redis_password
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@marasil.local"
MAIL_FROM_NAME="${APP_NAME}"

# Placeholders — set unique values; never commit real secrets
SESSION_MASTER_KEY=
INTERNAL_HMAC_SECRET=

WHATSAPP_SERVICE_URL=http://whatsapp-service:3100
WHATSAPP_SERVICE_TIMEOUT=10
WHATSAPP_ENGINE=baileys

VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"

# Docker api entrypoint (php-fpm only). Prefer setting these in the root .env
# that Compose loads via env_file — apps/platform/.env is optional for local.
RUN_MIGRATIONS=false
RUN_DB_SEED=false

# Production bootstrap (ProductionBootstrapSeeder) — not used in local/testing
# SUPER_ADMIN_PHONE=+9639xxxxxxx
# SUPER_ADMIN_PASSWORD=change_me_strong_password_12plus
# SUPER_ADMIN_NAME=Super Admin
# SUPER_ADMIN_COMPANY=Marasil
