# =============================================================================
# WhatsApp API SaaS — root environment (Docker Compose)
# Development login accounts are defined by database seeders, never by environment variables.
# Copy to .env and replace placeholders. Never commit real secrets.
# =============================================================================

COMPOSE_PROJECT_NAME=whatsapp-saas

# Docker Compose — enables: docker compose -f compose.yaml -f compose.dev.yaml --profile dev up -d
COMPOSE_PROFILES=dev

# --- Application ---
APP_NAME=Marasil
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
APP_TIMEZONE=UTC

# --- Ports (host) ---
NGINX_HTTP_PORT=8080
VITE_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379
WHATSAPP_SERVICE_PORT=3100

# --- Database (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=whatsapp_saas
DB_USERNAME=whatsapp
DB_PASSWORD=change_me_db_password

# --- Redis ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# --- Cache / Queue / Session ---
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# --- Internal secrets (generate unique values; placeholders only) ---
# APP_KEY: run `php artisan key:generate` inside the api container
# INTERNAL_HMAC_SECRET: shared HMAC between Laravel and WhatsApp service (32-byte base64)
# SESSION_MASTER_KEY: optional — defaults to INTERNAL_HMAC_SECRET in whatsapp-service when unset
INTERNAL_HMAC_SECRET=
SESSION_MASTER_KEY=
SOCKET_TOKEN_SECRET=
SESSION_KEY_ID=v1
OTP_PEPPER=
# Log OTP code to storage/logs/laravel.log in local (FakeOtpChannel)
OTP_EXPOSE_FOR_TESTS=true

# --- WhatsApp service ---
WHATSAPP_SERVICE_URL=http://whatsapp-service:3100
WHATSAPP_SERVICE_TIMEOUT=10
WHATSAPP_ENGINE=baileys
PLATFORM_INTERNAL_URL=http://nginx
WA_WORKER_ID=wa-worker-1
WA_LOG_LEVEL=info

# --- Storage (local private disk under storage/app/private) ---
FILESYSTEM_DISK=local
MEDIA_DISK=local
MEDIA_MAX_UPLOAD_MB=16
WEBHOOKS_REQUIRE_HTTPS=false

# --- Optional S3 object storage (production / external bucket) ---
# FILESYSTEM_DISK=s3
# MEDIA_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Mail (no production email channel in V1; log driver for Laravel internals) ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@marasil.local
MAIL_FROM_NAME="${APP_NAME}"

# --- Logging / observability ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Vite ---
VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"

# --- Backup / restore (local scripts) ---
BACKUP_DIR=./storage/backups
BACKUP_RETENTION_DAYS=7
